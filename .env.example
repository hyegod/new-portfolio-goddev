# Neon Postgres connection string (auto-injected by Vercel Storage -> Neon)
DATABASE_URL=

# Vercel Blob read/write token (auto-injected by Vercel Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Password to unlock /admin CMS Studio (set this in Vercel Project Settings -> Environment Variables)
ADMIN_PASSWORD=

# Optional dedicated HMAC signing secret for admin session cookies (falls back to ADMIN_PASSWORD if omitted)
ADMIN_SESSION_SECRET=
